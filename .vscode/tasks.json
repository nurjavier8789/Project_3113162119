{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ file",
            "type": "shell",
            "command": "g++",
            "args": ["-o", "${fileDirname}\\output\\${fileBasenameNoExtension}.exe", "${fileDirname}\\${fileBasename}"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Make new folder (for C++)",
            "type": "shell",
            "command": "if not exist ${fileDirname}\\output mkdir ${fileDirname}\\output",
        },
        {
            "label": "Folder maker and builder C++",
            "dependsOn": [
                "Make new folder (for C++)",
                "Build C++ file"
            ]
        },
        {
            "label": "C/C++: g++ build active file Linux",
            "type": "cppbuild",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/output/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler untuk C++"
        }
    ]
}